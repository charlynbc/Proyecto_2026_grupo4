# =====================================================================
# Variables de entorno del backend
#
# Copiar este archivo como .env y completar los valores:
#     cp .env.example .env
#
# El .env NO se sube a GitHub (está en el .gitignore).
# La contraseña de la base se pide por el chat del grupo, nunca por
# un documento compartido ni por el repositorio.
# =====================================================================


# ---------------------------------------------------------------------
# Base de datos — OBLIGATORIAS, el backend no arranca sin estas
# ---------------------------------------------------------------------

# Base compartida del equipo (Supabase). Pedir la contraseña al grupo.
DB_URL=jdbc:postgresql://aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.whocghntqkhmicabtoox
DB_PASSWORD=

# Si en vez de Supabase querés una base local en Docker, usar:
# DB_URL=jdbc:postgresql://localhost:5432/agenda
# DB_USER=agenda
# DB_PASSWORD=agenda


# ---------------------------------------------------------------------
# Firma de los JWT — OBLIGATORIA, el backend no arranca sin esta
# ---------------------------------------------------------------------

# Clave HS256. Se decodifica de base64 y tiene que dar 32 bytes o más.
# Generá la tuya con:
#     openssl rand -base64 32
JWT_SECRET_BASE64=


# ---------------------------------------------------------------------
# Notificaciones push
# ---------------------------------------------------------------------

# En false el backend arranca sin credenciales de Firebase.
# Ponelo en true SÓLO si tenés el JSON de la cuenta de servicio.
#
# Ojo: la anotación del backend usa matchIfMissing=true, así que si
# esta variable no está definida, Firebase se activa igual y el
# arranque falla. Dejala explícita.
APP_FIREBASE_ENABLED=false

# Ruta al JSON de la cuenta de servicio. Sólo hace falta si
# APP_FIREBASE_ENABLED=true. Ese archivo NO va al repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/firebase-adminsdk.json


# ---------------------------------------------------------------------
# CORS y cookies — tienen valores por defecto para desarrollo local
# ---------------------------------------------------------------------

# Origen desde el que se sirve el frontend web.
# El navegador bloquea las respuestas si esto no coincide.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# En local va en false / Lax.
# En producción, con el frontend en otro dominio, hay que poner
# COOKIE_SECURE=true y COOKIE_SAME_SITE=None, o el navegador no manda
# la cookie del refresh token y la sesión se cae sola.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax


# ---------------------------------------------------------------------
# Correo del primer ingreso (RF-02)
# ---------------------------------------------------------------------

# none   (por defecto) no envia nada y registra el fallo; el backend arranca igual.
# smtp   desarrollo local con Mailpit (docker run -p 8025:8025 -p 1025:1025 axllent/mailpit,
#        bandeja en http://localhost:8025). No sale ningun correo a destinatarios reales.
# resend API HTTPS, para Railway.
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost

# Direccion del cliente Flutter web (estrategia de URL con #). El backend agrega ?token=
FIRST_LOGIN_URL=http://localhost:5173/#/primer-ingreso

# Solo con MAIL_PROVIDER=resend (no commitear):
# RESEND_API_KEY=
