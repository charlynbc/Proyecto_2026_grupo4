# =====================================================================
# Variables de entorno del backend
#
# Copiar este archivo como .env y completar los valores:
#     cp .env.example .env
#
# El .env NO se sube a GitHub (está en el .gitignore).
# La contraseña de la base se pide por el chat del grupo, nunca por
# un documento compartido ni por el repositorio.
#
# En Railway estas mismas variables se cargan en el panel del servicio
# (Variables → Raw Editor). Ahí cambian los valores marcados como
# "En Railway" más abajo.
# =====================================================================


# ---------------------------------------------------------------------
# Base de datos — OBLIGATORIAS, el backend no arranca sin estas
# ---------------------------------------------------------------------

# Base local aislada para desarrollo. Inicializala con:
#     psql -d agenda -f database/schema.sql
DB_URL=jdbc:postgresql://localhost:5432/agenda
DB_USER=agenda
DB_PASSWORD=agenda


# ---------------------------------------------------------------------
# Firma de los JWT — OBLIGATORIA, el backend no arranca sin esta
# ---------------------------------------------------------------------

# Clave HS256. Se decodifica de base64 y tiene que dar 32 bytes o más.
# Generá la tuya con:
#     openssl rand -base64 32
# En Railway va una clave propia, distinta de la de cualquier máquina.
JWT_SECRET_BASE64=


# ---------------------------------------------------------------------
# Notificaciones push
# ---------------------------------------------------------------------

# En false el backend arranca sin credenciales de Firebase.
# Ponelo en true SÓLO si tenés el JSON de la cuenta de servicio.
#
# Ojo: la anotación del backend usa matchIfMissing=true, así que si
# esta variable no está definida, Firebase se activa igual y el
# arranque falla. Dejala explícita.
APP_FIREBASE_ENABLED=false

# Ruta al JSON de la cuenta de servicio. Sólo hace falta si
# APP_FIREBASE_ENABLED=true. Ese archivo NO va al repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/firebase-adminsdk.json


# ---------------------------------------------------------------------
# Correo del primer ingreso (RF-02)
# ---------------------------------------------------------------------

# none   No envía; registra el fallo y el backend arranca igual.
# smtp   Desarrollo local con Mailpit; no envía correos a destinatarios reales.
# resend Railway, mediante la API HTTPS de Resend.
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

# Enlaces que van dentro de los correos. El backend les agrega ?token=...
#
# La app web usa rutas con # (estrategia por defecto de Flutter), por eso
# el enlace de primer ingreso lleva /#/.
# En Railway: https://<dominio-de-railway>/#/primer-ingreso
FIRST_LOGIN_URL=http://localhost:5173/#/primer-ingreso
# La validez del enlace de primer ingreso (FIRST_LOGIN_TOKEN_VALIDITY_HOURS)
# se configura en "Reglas de negocio", más abajo.

# Enlaces de recuperación de contraseña (RF-05) y de confirmación de cambio
# de correo (RF-06). Mismo criterio: el backend les agrega ?token=...
# En Railway: https://<dominio-de-railway>/#/recuperacion y .../#/cambio-correo
RECOVERY_URL=http://localhost:5173/#/recuperacion
CHANGE_EMAIL_URL=http://localhost:5173/#/cambio-correo
# La validez de esos enlaces (RECOVERY_TOKEN_VALIDITY_HOURS y
# EMAIL_CHANGE_TOKEN_VALIDITY_HOURS) también está en "Reglas de negocio".

# Solo con MAIL_PROVIDER=resend. Cargar el secreto en el panel de Railway,
# nunca en este archivo ni en Git.
# RESEND_API_KEY=


# ---------------------------------------------------------------------
# CORS y cookies — tienen valores por defecto para desarrollo local
# ---------------------------------------------------------------------

# Origen desde el que se sirve el frontend web. En local, Flutter con
# --web-port=5173 (ver CONTRIBUTING.md). El navegador bloquea las
# respuestas si esto no coincide.
#
# En Railway: https://<dominio-de-railway>, aunque la web y la API estén en
# el mismo dominio. El proxy de Railway le pasa los pedidos al backend por
# una conexión interna, así que el backend no reconoce el origen como propio
# y sin esto rechaza el login con "Invalid CORS request".
CORS_ALLOWED_ORIGIN=http://localhost:5173

# En local van en false / Lax, porque no hay HTTPS.
#
# En Railway: COOKIE_SECURE=true (hay HTTPS) y COOKIE_SAME_SITE se deja
# en Lax. La web se sirve desde el mismo dominio que la API (decisión de
# arquitectura), así que la cookie del refresh token nunca es de terceros
# y no hace falta SameSite=None, que además Safari bloquea.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax


# ---------------------------------------------------------------------
# Reglas de negocio
# ---------------------------------------------------------------------

# Parámetros de negocio (RNF-26, sección 3.1.3 de Requerimientos).
#
# Todos son opcionales: sin la variable rige el valor que aparece acá, que es
# el definido en Requerimientos. Solo hace falta descomentar y cargar una
# variable para usar otro valor. Los lee un único componente (ParametroService)
# al arrancar: todos deben ser enteros mayores que cero, los mínimos no pueden
# superar a los máximos y el paso de duración debe dividir el rango. Un valor
# inválido impide arrancar y el mensaje nombra la variable. Un cambio se aplica
# al reiniciar el backend, sin reconstruirlo.

# Anticipación máxima para agendar, en días.
# PARAM_AGENDAR_ANTICIPACION_MAXIMA_DIAS=30
# Anticipación mínima para agendar, en horas antes de la hora del número.
# PARAM_AGENDAR_ANTICIPACION_MINIMA_HORAS=2
# Anticipación mínima para cancelar, en horas antes del inicio de la consulta.
# PARAM_CANCELAR_ANTICIPACION_MINIMA_HORAS=2

# Consultas activas que puede tener un socio en una misma especialidad.
# PARAM_CONSULTAS_ACTIVAS_POR_ESPECIALIDAD=1
# Consultas activas que puede tener un socio en total.
# PARAM_CONSULTAS_ACTIVAS_TOTAL=3

# Duración de un número, en minutos: mínima, máxima y paso. Los horarios de
# inicio y fin también deben caer en múltiplos del paso.
# PARAM_NUMERO_DURACION_MINIMA_MINUTOS=10
# PARAM_NUMERO_DURACION_MAXIMA_MINUTOS=60
# PARAM_NUMERO_DURACION_PASO_MINUTOS=5

# Vigencia de un pase, en días: la que se aplica si el médico no indica otra, y
# el rango que el médico puede fijar. La inicial debe caer dentro del rango.
# PARAM_PASE_VIGENCIA_INICIAL_DIAS=90
# PARAM_PASE_VIGENCIA_MINIMA_DIAS=1
# PARAM_PASE_VIGENCIA_MAXIMA_DIAS=365

# Antelación del recordatorio de consulta, en horas. Se lee y se valida, pero
# todavía no la usa ningún envío: el recordatorio no está implementado.
# PARAM_RECORDATORIO_ANTELACION_HORAS=24

# Largo mínimo de la contraseña, en caracteres.
# PASSWORD_MIN_LENGTH=8

# Vigencia de los enlaces enviados por correo, en horas: primer ingreso,
# recuperación de contraseña y cambio de correo.
#
# Las tres pantallas del frontend dicen "vale 24 horas" con texto fijo. Si se
# cambia alguna de estas variables, hay que cambiar también el texto en
# frontend/lib/features/auth/screens/: first_login_request_screen.dart,
# password_recovery_request_screen.dart y confirm_email_change_screen.dart.
# FIRST_LOGIN_TOKEN_VALIDITY_HOURS=24
# RECOVERY_TOKEN_VALIDITY_HOURS=24
# EMAIL_CHANGE_TOKEN_VALIDITY_HOURS=24
