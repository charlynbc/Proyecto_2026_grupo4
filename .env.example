# =====================================================================
# Variables de entorno del backend
#
# Copiar este archivo como .env y completar los valores:
#     cp .env.example .env
#
# El .env NO se sube a GitHub (está en el .gitignore).
# La contraseña de la base se pide por el chat del grupo, nunca por
# un documento compartido ni por el repositorio.
#
# En Railway estas mismas variables se cargan en el panel del servicio
# (Variables → Raw Editor). Ahí cambian los valores marcados como
# "En Railway" más abajo.
# =====================================================================


# ---------------------------------------------------------------------
# Base de datos — OBLIGATORIAS, el backend no arranca sin estas
# ---------------------------------------------------------------------

# Proyecto AgendaMedica de Supabase (São Paulo). Tiene dos bases con el
# mismo esquema (database/schema.sql): "test", para desarrollar, y
# "prod", sólo para el despliegue. En local se usa siempre test.
# Se conecta por el pooler en modo sesión (puerto 5432).
DB_URL=jdbc:postgresql://aws-1-sa-east-1.pooler.supabase.com:5432/test?sslmode=require
DB_USER=postgres.fjfhbpimkgutowpudcri
DB_PASSWORD=

# Si en vez de Supabase querés una base local, creá el esquema con
#     psql -d agenda -f database/schema.sql
# y usá:
# DB_URL=jdbc:postgresql://localhost:5432/agenda
# DB_USER=agenda
# DB_PASSWORD=agenda


# ---------------------------------------------------------------------
# Firma de los JWT — OBLIGATORIA, el backend no arranca sin esta
# ---------------------------------------------------------------------

# Clave HS256. Se decodifica de base64 y tiene que dar 32 bytes o más.
# Generá la tuya con:
#     openssl rand -base64 32
# En Railway va una clave propia, distinta de la de cualquier máquina.
JWT_SECRET_BASE64=


# ---------------------------------------------------------------------
# Notificaciones push
# ---------------------------------------------------------------------

# En false el backend arranca sin credenciales de Firebase.
# Ponelo en true SÓLO si tenés el JSON de la cuenta de servicio.
#
# Ojo: la anotación del backend usa matchIfMissing=true, así que si
# esta variable no está definida, Firebase se activa igual y el
# arranque falla. Dejala explícita.
APP_FIREBASE_ENABLED=false

# Ruta al JSON de la cuenta de servicio. Sólo hace falta si
# APP_FIREBASE_ENABLED=true. Ese archivo NO va al repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/firebase-adminsdk.json


# ---------------------------------------------------------------------
# Correo (SMTP) — opcional para arrancar, necesario para los enlaces
# ---------------------------------------------------------------------

# Sin MAIL_HOST el backend arranca igual, pero no salen los correos: el
# enlace de primer ingreso (RF-02) no llega y el error queda en el log.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente. Si se deja vacío se usa MAIL_USERNAME.
MAIL_FROM=

# Enlaces que van dentro de los correos. El backend les agrega ?token=...
#
# La app web usa rutas con # (estrategia por defecto de Flutter), por eso
# el enlace de primer ingreso lleva /#/.
# En Railway: https://<dominio-de-railway>/#/primer-ingreso
FIRST_LOGIN_URL=http://localhost:5173/#/primer-ingreso
# Sólo lo usa el registro heredado de la prueba de concepto
# (/api/auth/registro), que trabaja sobre el esquema "POC". Apunta directo
# al endpoint del backend que confirma el correo.
EMAIL_VERIFICATION_URL=http://localhost:8080/api/auth/confirmar-email


# ---------------------------------------------------------------------
# CORS y cookies — tienen valores por defecto para desarrollo local
# ---------------------------------------------------------------------

# Origen desde el que se sirve el frontend web. En local, Flutter con
# --web-port=5173 (ver CONTRIBUTING.md). El navegador bloquea las
# respuestas si esto no coincide.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# En local van en false / Lax, porque no hay HTTPS.
#
# En Railway: COOKIE_SECURE=true (hay HTTPS) y COOKIE_SAME_SITE se deja
# en Lax. La web se sirve desde el mismo dominio que la API (decisión de
# arquitectura), así que la cookie del refresh token nunca es de terceros
# y no hace falta SameSite=None, que además Safari bloquea.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax


# ---------------------------------------------------------------------
# Reglas de negocio
# ---------------------------------------------------------------------

# Largo mínimo de contraseña. Por defecto 8.
# PASSWORD_MIN_LENGTH=8
